# Keycloak requires the client secret on introspection. This Dovecot build
# posts only the token, so the local proxy adds the secret.
oauth2 {
  introspection_mode = post
  introspection_url = http://127.0.0.1:8765/introspect
  client_id = @DOVECOT_OAUTH_CLIENT_ID@
  client_secret = @DOVECOT_OAUTH_CLIENT_SECRET@
  username_attribute = email
  active_attribute = active
  active_value = true
}
