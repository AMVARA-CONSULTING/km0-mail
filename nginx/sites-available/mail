# KM0 Mail — webmail + auth pages (TLS on host Nginx)
# Hostname: mail.km0digital.com
#
# Deploy auth static files:
#   sudo rsync -a host-www/mail-auth/ /var/www/mail-auth/
#   sudo cp nginx/sites-available/mail /etc/nginx/sites-available/mail
#   sudo nginx -t && sudo systemctl reload nginx
#
# Roundcube upstream: 127.0.0.1:8080
# mail-provision-api: 127.0.0.1:8092 (public /register + provisioning)
# domain-verify-api: 127.0.0.1:8093
# NOTE: km0-opencloud register-api (:8091) is no longer used for the KM0 signup
#       happy path; /api/register now targets the self-contained :8092 endpoint.

server {
    listen 80;
    listen [::]:80;
    server_name mail.km0digital.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name mail.km0digital.com;

    ssl_certificate     /etc/letsencrypt/live/mail.km0digital.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mail.km0digital.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 25M;

    # Native branded login is the canonical entry point (no forced Auth Hub redirect).
    # Roundcube deep links / logged-in sessions carry $args and go straight to the app.
    location = / {
        if ($args) {
            return 302 $scheme://$host/index.php?$args;
        }
        rewrite ^ /login.html last;
    }

    location = /login.html {
        alias /var/www/mail-auth/login.html;
        default_type text/html;
    }

    # Serve the local register page; backend wiring is handled by the
    # self-contained-registration FEAT.
    location = /register {
        alias /var/www/mail-auth/register.html;
        default_type text/html;
    }

    location = /register.html {
        return 301 /register$is_args$args;
    }

    location = /domain.html {
        alias /var/www/mail-auth/domain.html;
        default_type text/html;
    }

    location = /verify {
        alias /var/www/mail-auth/verify.html;
        default_type text/html;
    }

    location = /km0-auth.css {
        alias /var/www/mail-auth/km0-auth.css;
        default_type text/css;
        expires 1h;
    }

    location = /km0-auth-i18n.js {
        alias /var/www/mail-auth/km0-auth-i18n.js;
        default_type application/javascript;
        expires 1h;
    }

    location = /dex-auth.js {
        alias /var/www/mail-auth/dex-auth.js;
        default_type application/javascript;
        expires 1h;
    }

    location = /logo.svg {
        alias /var/www/mail-auth/logo.svg;
        default_type image/svg+xml;
        expires 7d;
        access_log off;
    }

    location = /favicon.svg {
        alias /var/www/mail-auth/favicon.svg;
        default_type image/svg+xml;
        expires 7d;
        access_log off;
    }

    # Dex i18n for LDAP login button labels
    location = /dex/theme/i18n.js {
        proxy_pass https://cloud.km0digital.com/dex/theme/i18n.js;
        proxy_ssl_server_name on;
        expires 1h;
    }

    # Self-registration (same-origin proxy avoids CORS). Self-contained on the
    # mail host: mail-provision-api :8092 public /register (no cross-repo :8091).
    # X-Real-IP / X-Forwarded-For are required for the API's per-IP rate limit.
    location = /api/register {
        proxy_pass http://127.0.0.1:8092/register;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /api/mail/ {
        proxy_pass http://127.0.0.1:8092/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/mail/domain/ {
        proxy_pass http://127.0.0.1:8093/domain/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Roundcube webmail (native login at /index.php?_task=login, OAuth at /index.php/login/oauth)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
}
